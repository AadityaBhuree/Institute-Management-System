# ==============================================================================
# Institute Management System (IMS Enterprise) — Environment Configuration
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env':
#      cp .env.example .env   (Linux/macOS)
#      copy .env.example .env (Windows)
# 2. Update the secret key and domain settings for your target environment.
# ==============================================================================

# [SECURITY - REQUIRED IN PRODUCTION]
# A strong, unique secret key for cryptographic signatures and session tokens.
# Generate one using: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change_this_to_a_secure_random_key_in_production

# [ENVIRONMENT & DEBUG]
# Options: development, staging, production
ENVIRONMENT=development
DEBUG=false

# [API DOCUMENTATION]
# Toggles /docs, /redoc, and /openapi.json. Automatically disabled in production unless overridden.
ENABLE_DOCS=true

# [CORS - ALLOWED ORIGINS]
# Comma-separated list of trusted HTTP/HTTPS origins allowed for cross-origin requests.
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# [DATABASE PATH OVERRIDE]
# Optional path override for the SQLite database. Defaults to data/institute.db
# IMS_DB_PATH=data/institute.db

# [RATE LIMITING]
# Global rate limiting toggle and default ceiling per client IP
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=100/minute

# [SECURITY HEADERS & BRUTE FORCE PROTECTION]
# Maximum allowable request body size in bytes (default 10MB: 10485760)
MAX_REQUEST_SIZE_BYTES=10485760

# Maximum consecutive failed login attempts before temporary account lockout
LOGIN_MAX_ATTEMPTS=5

# Duration of brute-force login lockout in seconds (default 300s = 5 minutes)
LOGIN_LOCKOUT_SECONDS=300
